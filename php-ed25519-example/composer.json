{
    "name": "example/php-ed25519-example",
    "description": "Ed25519 request signing and verification example service built on Slim 4",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-apcu": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/uid": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "start": "php -d apc.enable_cli=1 -d post_max_size=16M -S 0.0.0.0:8080 -t public",
        "test": "php -d apc.enable_cli=1 vendor/bin/phpunit",
        "test:docker": "docker build -q -f docker/test.Dockerfile -t php-ed25519-example-test . && docker run --rm -v \"$PWD/..\":/repo -w /repo/php-ed25519-example php-ed25519-example-test"
    }
}
